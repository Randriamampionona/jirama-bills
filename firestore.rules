rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // BILLS: signed-in users can read and create the monthly record.
    // Updates allowed EXCEPT reverting a completed reading (one-way status).
    // This permits marking done and editing the amount, but never done->not_done.
    match /BILLS/{billId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null
        && !(resource.data.status == 'done' && request.resource.data.status == 'not_done');
      allow delete: if false;
    }

    // users: each signed-in user reads all (for bill splitting) but writes
    // only their OWN record. auth.uid == Clerk id via the integration token.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}